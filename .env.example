# GitLab Configuration
# Your GitLab instance URL (default is https://gitlab.com)
GITLAB_URL=https://gitlab.com

# Your GitLab project ID (can be found in project settings)
# Example: 12345678 or group/project-name
GITLAB_PROJECT_ID=your_project_id_here

# Your GitLab private token (create one in User Settings > Access Tokens)
# Required scopes: api, read_api
GITLAB_PRIVATE_TOKEN=your_private_token_here

# ClickUp Configuration
# Your ClickUp API token (create one in ClickUp Settings > Apps)
# Optional: If not set, ClickUp task information will not be displayed
CLICKUP_API_TOKEN=your_clickup_api_token_here

# Application Configuration
PORT=5000
DEBUG=False
